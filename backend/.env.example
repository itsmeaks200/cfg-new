PORT=5000
CORS_ORIGIN=http://localhost:5173
# Local Docker Postgres example:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cfg
# Neon example (copy the pooled connection string from the Neon dashboard):
# DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/cfg?sslmode=require
# DATABASE_SSL=true
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
COORDINATOR_INVITE_EXPIRES_HOURS=72
